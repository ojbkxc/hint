{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "hint",
  "version": "0.1.0",
  "identifier": "com.ojbkxc.hint",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "hint · 面试提词器",
        "width": 920,
        "height": 700,
        "minWidth": 760,
        "minHeight": 560,
        "visible": true
      },
      {
        "label": "overlay",
        "title": "hint overlay",
        "width": 460,
        "height": 340,
        "minWidth": 320,
        "minHeight": 180,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "focus": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
