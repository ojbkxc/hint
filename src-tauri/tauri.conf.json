{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "hint",
  "version": "1.1.79",
  "identifier": "com.ojbkxc.hint",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "hint · 面试提词器",
        "width": 920,
        "height": 700,
        "minWidth": 760,
        "minHeight": 560,
        "center": true,
        "visible": true
      },
      {
        "label": "overlay",
        "title": "hint overlay",
        "width": 640,
        "height": 360,
        "minWidth": 320,
        "minHeight": 180,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "focus": false,
        "visible": true
      },
      {
        "label": "capture",
        "title": "hint capture",
        "width": 1920,
        "height": 1080,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "focus": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src ipc: http://ipc.localhost",
      "devCsp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src ipc: http://ipc.localhost ws://localhost:1420 http://localhost:1420"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "ojbkxc",
    "copyright": "Copyright © 2026 ojbkxc",
    "shortDescription": "hint · 面试实时提词器",
    "longDescription": "本地语音识别、双通道区分面试官与候选人、三种大模型协议流式作答的 Windows 面试提词器。",
    "category": "Productivity",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese"],
        "displayLanguageSelector": false
      }
    }
  }
}
